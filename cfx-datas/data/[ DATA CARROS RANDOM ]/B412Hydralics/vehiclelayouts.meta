<?xml version="1.0" encoding="UTF-8"?>
<CVehicleMetadataMgr>

<!---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------->
<!---------------------------------------------------------------------------------------------Funcao para Puxar as animacoes para dentro do Layout--------------------------------------------------------------------------------------------------------------->


  <ClipSetMaps>
  
<!------------------------------------------------------------------------------- Animacao Assento Frontal Direito ------------------------------------------------------------------------------------------------------------------------------------------------->
    <Item type="CClipSetMap">
      <Name>INSIDE_CLIPSET_MAP_HELI_GAEP_SIDE_RIGHT</Name>
      <Maps>
        <Item>
          <ClipSetId>anim@veh@helicopter@gaep@side@ps@enter_exit</ClipSetId>
          <VarClipSetId>InsideVarClipSet</VarClipSetId>
          <ConditionFlags />
          <InformationFlags />
        </Item>
      </Maps>
    </Item>
<!------------------------------------------------------------------------------- Animacao Assento Frontal Esquerdo ------------------------------------------------------------------------------------------------------------------------------------------------->
    <Item type="CClipSetMap">
      <Name>INSIDE_CLIPSET_MAP_HELI_GAEP_SIDE_LEFT</Name>
      <Maps>
        <Item>
          <ClipSetId>anim@veh@helicopter@gaep@side@ds@enter_exit</ClipSetId>
          <VarClipSetId>InsideVarClipSet</VarClipSetId>
          <ConditionFlags />
          <InformationFlags />
        </Item>
      </Maps>
    </Item>
<!------------------------------------------------------------------------------- Animacao Assento Traseiro Esquerdo ------------------------------------------------------------------------------------------------------------------------------------------------->
    <Item type="CClipSetMap">
      <Name>INSIDE_CLIPSET_MAP_HELI_GAEP_REAR_LEFT</Name>
      <Maps>
        <Item>
          <ClipSetId>anim@veh@helicopter@gaep@rear@ds@enter_exit</ClipSetId>
          <VarClipSetId>InsideVarClipSet</VarClipSetId>
          <ConditionFlags />
          <InformationFlags />
        </Item>
      </Maps>
    </Item>
	
   </ClipSetMaps>
 
 
<!---------------------------------------------------------------------------------------------Funcao para Puxar as animacoes para dentro do Layout--------------------------------------------------------------------------------------------------------------->
<!---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------->





<!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------->
<!------------------------------------------------------------------------------- Configuração Geral dos Assentos ------------------------------------------------------------------------------------------------------------------------------------------------->


  <VehicleLayoutInfos>

      <Item type="CVehicleLayoutInfo">
      <Name>LAYOUT_HELI_LITTLEBIRD</Name>
      <Seats>
       <Item>
          <SeatInfo ref="SEAT_STANDARD_FRONT_LEFT" />
          <SeatAnimInfo ref="SEAT_ANIM_HELI_FRONT_LEFT" />
        </Item>
        <Item>
          <SeatInfo ref="SEAT_STANDARD_FRONT_RIGHT" />
          <SeatAnimInfo ref="SEAT_ANIM_HELI_FRONT_RIGHT" />
        </Item>
		<!-- Assento lateral frontal esquerdo-->
        <Item>
          <SeatInfo ref="SEAT_HELI_SVOL_REAR_LEFT" />
          <SeatAnimInfo ref="SEAT_ANIM_HELI_REAR_ATIRADOR_LEFT" />
        </Item>
		<!-- Assento lateral frontal direito-->
        <Item>
          <SeatInfo ref="SEAT_HELI_SVOL_REAR_RIGHT" />
          <SeatAnimInfo ref="SEAT_ANIM_HELI_REAR_ATIRADOR_RIGHT" />
        </Item>
		<!-- Assentoo traseiro direito-->
        <Item>
          <SeatInfo ref="SEAT_EXTRA_NO_SHUFFLE_RIGHT_1" />
          <SeatAnimInfo ref="SEAT_ANIM_HELI_LITTLEBIRD_REAR_RIGHT" />
        </Item>
		<!-- Assento lateral traseiro direito-->
        <Item>
          <SeatInfo ref="SEAT_EXTRA_NO_SHUFFLE_RIGHT_2" />
          <SeatAnimInfo ref="SEAT_ANIM_HELI_REAR_ATIRADOR_RIGHT2" />
        </Item>
		<!-- Assento traseiro esquerdo-->
        <Item>
          <SeatInfo ref="SEAT_EXTRA_NO_SHUFFLE_LEFT_1" />
          <SeatAnimInfo ref="SEAT_ANIM_HELI_LITTLEBIRD_REAR_LEFT" />
        </Item>
		<!-- Assento lateral traseiro esquerdo-->
        <Item>
          <SeatInfo ref="SEAT_EXTRA_NO_SHUFFLE_LEFT_2" />
          <SeatAnimInfo ref="SEAT_ANIM_HELI_REAR_ATIRADOR_LEFT2" />
        </Item>
      </Seats>
      <EntryPoints>
         <Item>
          <EntryPointInfo ref="ENTRY_POINT_STANDARD_FRONT_LEFT" />
          <EntryPointAnimInfo ref="ENTRY_POINT_ANIM_HELI_SVOL_FRONT_LEFT" />
        </Item>
        <Item>
          <EntryPointInfo ref="ENTRY_POINT_STANDARD_FRONT_RIGHT" />
          <EntryPointAnimInfo ref="ENTRY_POINT_ANIM_HELI_SVOL_FRONT_RIGHT" />
        </Item>
		<!-- Assento lateral frontal esquerdo-->
        <Item>
          <EntryPointInfo ref="ENTRY_POINT_LITTLEBIRD_WARP_LEFT" />
          <EntryPointAnimInfo ref="ENTRY_POINT_ANIM_HELI_LITTLEBIRD_LEFT" />
        </Item>
		<!-- Assento lateral frontal direito-->
        <Item>
          <EntryPointInfo ref="ENTRY_POINT_LITTLEBIRD_WARP_RIGHT" />
          <EntryPointAnimInfo ref="ENTRY_POINT_ANIM_HELI_LITTLEBIRD_RIGHT" />
        </Item>
		<!-- Assento traseiro direito-->
        <Item>
          <EntryPointInfo ref="ENTRY_POINT_HELI_LITTLEBIRD_REAR_RIGHT" />
          <EntryPointAnimInfo ref="ENTRY_POINT_ANIM_HELI_LITTLEBIRD_REAR_RIGHT" />
        </Item>
		<!-- Assento lateral traseiro direito-->
		<Item>
		  <EntryPointInfo ref="ENTRY_POINT_LITTLEBIRD_WARP_RIGHT2" />
		  <EntryPointAnimInfo ref="ENTRY_POINT_ANIM_HELI_LITTLEBIRD_RIGHT2" />
		</Item>
		<!-- Assento traseiro esquerdo-->
        <Item>
          <EntryPointInfo ref="ENTRY_POINT_HELI_LITTLEBIRD_REAR_LEFT" />
          <EntryPointAnimInfo ref="ENTRY_POINT_ANIM_HELI_LITTLEBIRD_REAR_LEFT" />
        </Item>
		<!-- Assento lateral traseiro esquerdo-->
		<Item>
		  <EntryPointInfo ref="ENTRY_POINT_LITTLEBIRD_WARP_LEFT2" />
		  <EntryPointAnimInfo ref="ENTRY_POINT_ANIM_HELI_LITTLEBIRD_LEFT2" />
		</Item>
      </EntryPoints>
      <LayoutFlags>StreamAnims UseFinerAlignTolerance Use2DBodyBlend</LayoutFlags>
      <BicycleInfo ref="NULL" />
      <HandsUpClipSetId>busted_vehicle_std</HandsUpClipSetId>
      <SteeringWheelOffset x="0.000000" y="0.350000" z="0.320000" />
    </Item>
	
  </VehicleLayoutInfos>	
  
  
